{
  "name": "maoxian-web-clipper",
  "version": "0.8.0",
  "description": "A web extension to clip information from web page. Save it to your local machine to avoid information invalidation. Not bored registration, Not charged.",
  "main": "",
  "type": "module",
  "scripts": {
    "build-chromium": "cross-env NODE_ENV=development MX_PLATFORM=chromium MX_PLATFORM_ID=$MX_DEV_CHROMIUM_ID MX_PLATFORM_UPDATE_URL=$MX_DEV_CHROMIUM_UPDATE_URL_MV3 webpack --mode=development --progress",
    "build-firefox": "cross-env NODE_ENV=development MX_PLATFORM=firefox MX_PLATFORM_ID=$MX_DEV_FIREFOX_ID webpack --mode=development --progress",


    "build-chromium-production": "cross-env NODE_ENV=production MX_PLATFORM=chromium MX_PLATFORM_ID=$MX_CHROMIUM_ID MX_PLATFORM_UPDATE_URL=$MX_CHROMIUM_UPDATE_URL_MV3 webpack --mode=production --progress",
    "build-firefox-production": "cross-env NODE_ENV=production MX_PLATFORM=firefox MX_PLATFORM_ID=$MX_FIREFOX_ID webpack --mode=production --progress",
    "build-all-production": "npm run build-chromium && npm run build-firefox",

    "test": "mocha --recursive",


    "sep0": "=======================================================",
    "sep1": "Belowing scripts are for the laze people",
    "sep2": "=======================================================",


    "comment-ignore-me_autobuild": "Watch the source code changes and auto build/compile it",
    "auto-build-chromium": "cross-env NODE_ENV=development MX_PLATFORM=chromium MX_PLATFORM_ID=$MX_DEV_CHROMIUM_ID MX_PLATFORM_UPDATE_URL=$MX_DEV_CHROMIUM_UPDATE_URL_MV3 webpack --mode=development --watch --progress",
    "auto-build-firefox": "cross-env NODE_ENV=development MX_PLATFORM=firefox MX_PLATFORM_ID=$MX_DEV_FIREFOX_ID webpack --mode=development --watch --progress",


    "comment-ignore-me_autoload": "Start the browser with a temporary profile, and auto reload the extension",
    "auto-reload-chromium": "web-ext run --target chromium --source-dir dist/extension/maoxian-web-clipper",
    "auto-reload-firefox": "web-ext run --target firefox-desktop --source-dir dist/extension/maoxian-web-clipper",


    "comment-ignore-me_juststart": "Only start the browser with a temporary profile, without auto reload the exension",
    "start-chromium": "web-ext run --no-reload --target chromium --source-dir dist/extension/maoxian-web-clipper",
    "start-firefox": "web-ext run --no-reload --target firefox-desktop --source-dir dist/extension/maoxian-web-clipper"

  },
  "author": "Mika",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.9.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.9.0",
    "@babel/plugin-transform-runtime": "^7.9.0",
    "@babel/preset-env": "^7.9.0",
    "@babel/runtime": "^7.9.2",
    "babel-loader": "^8.3.0",
    "clean-webpack-plugin": "^3.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.2",
    "esm": "^3.2.25",
    "jsdom": "^21.1.1",
    "mocha": "^12.0.0-rc.6",
    "remove-files-webpack-plugin": "^1.5.0",
    "sinon-chrome": "^3.0.1",
    "webpack": "^5.61.0",
    "webpack-cli": "^4.9.1",
    "zip-webpack-plugin": "^4.0.3"
  },
  "dependencies": {
    "awesomplete": "^1.1.5",
    "blueimp-md5": "^2.12.0",
    "css-selector-generator": "^3.4.4",
    "css.escape": "^1.5.1",
    "magic-bytes.js": "^1.0.17",
    "mathml2latex": "^1.1.3",
    "mustache": "^4.2.0",
    "pikaday": "^1.8.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "webextension-polyfill": "^0.8.0"
  }
}
